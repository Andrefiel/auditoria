# ---------- PostgreSQL ----------
POSTGRES_DB=auditoria
POSTGRES_USER=auditoria_app
POSTGRES_PASSWORD=troque_esta_senha

# ---------- Backend ----------
BACKEND_PORT=4000
JWT_SECRET=troque_por_uma_string_aleatoria_longa
APP_URL=https://auditoria.suporteargos.com.br

# ---------- LDAP / Active Directory (bind da aplicação) ----------
LDAP_URL=ldap://192.168.0.10:389
LDAP_BIND_DN=cn=svc_auditoria,ou=Servicos,dc=argos,dc=local
LDAP_BIND_PASSWORD=senha_da_conta_de_servico
LDAP_BASE_DN=dc=argos,dc=local
LDAP_USER_SEARCH_BASE=ou=Usuarios,dc=argos,dc=local
LDAP_GROUP_AUDITORES_LIDERES=cn=auditores_lideres,ou=Grupos Argos,dc=argos,dc=local

# ---------- SMTP (notificação de aprovação, Exchange Online) ----------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=auditoria@argospatologia.com.br
SMTP_PASSWORD=senha_ou_app_password
SMTP_FROM="Auditoria Interna Argos <auditoria@argospatologia.com.br>"
